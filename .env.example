APP_NAME=Beginner RAG Chatbot
DEBUG=true

# Local MySQL. Docker Compose overrides the hostname from localhost to mysql.
MYSQL_URL=mysql+pymysql://rag_user:rag_password@localhost:3306/rag_chatbot

# Create a Pinecone dense index with dimension 384 and cosine similarity.
PINECONE_API_KEY=replace_me
PINECONE_INDEX_NAME=rag-chatbot
# Optional: using the index host is slightly faster than resolving the name.
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=documents

# Generate a key at https://console.groq.com/keys
GROQ_API_KEY=replace_me
# Pick a chat-completion model available on Groq.
GROQ_MODEL=openai/gpt-oss-20b

# Generate a read token at https://huggingface.co/settings/tokens
# Used to call the hosted embeddings API instead of loading the model locally.
HF_TOKEN=replace_me
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.20
USE_HYBRID_SEARCH=false
MAX_UPLOAD_MB=20
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=*
